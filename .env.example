# Browser API — absolute URL so login cookies (SameSite=None on api.devora21.com) work.
# Do NOT set this to /backend on Netlify unless the API rewrites Set-Cookie for the site host.
NEXT_PUBLIC_API_BASE_URL=https://api.devora21.com

# Server-side upstream (Netlify functions + Next.js API routes). Absolute URL only.
BACKEND_API_URL=https://api.devora21.com

# Optional same-origin proxy (advanced). Only if backend Set-Cookie works through Netlify:
# NEXT_PUBLIC_API_BASE_URL=/backend

# Local dev against a machine on your network (optional):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
# BACKEND_API_URL=http://localhost:5000

# Shared secret for Next.js / Netlify → api.devora21.com AI calls (server-only).
# Set the same value on the backend server as AI_INTERNAL_API_KEY.
# Do NOT use NEXT_PUBLIC_ for this — Netlify secrets scanning will fail the build.
AI_INTERNAL_API_KEY=your_internal_ai_service_key_here

# DeepSeek API key — set ONLY on api.devora21.com (backend server), not Netlify.
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Job crawl → Google Sheet ("Add Sheet" on the Job Crawl dashboard).
# Share the spreadsheet with the service account email as Editor.
# Tab names must match exactly: Brazil | Argentina | Colombia | Dominican Republic | Other
# Columns: No | Date | Day_Count | Country | Job_Platform | Job_URL
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
# Prefer one JSON env var (escape newlines in private_key as \n):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",...}
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
