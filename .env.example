# Backend API base URL (no trailing slash) — used server-side by Next.js API routes
API_BASE_URL=http://31.44.7.64:5000

# Optional public copy for local tooling (browser auth uses /api/auth proxy on HTTPS)
NEXT_PUBLIC_API_BASE_URL=http://31.44.7.64:5000

# Required for AI resume generation (set in Netlify → Site settings → Environment variables)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Also set DEEPSEEK_API_KEY on your VPS backend (31.44.7.64) for Netlify production generation