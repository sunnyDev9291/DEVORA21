# Browser API base — leave EMPTY on Netlify to use same-origin /backend proxy (fixes mixed content).
# Set to https://api.devora21.com only when the VPS API has TLS.
NEXT_PUBLIC_API_BASE_URL=

# Server-side direct VPS URL (Netlify functions, resume archive). Not exposed to the browser.
BACKEND_API_URL=http://31.44.7.64:5000

# Required for AI resume generation — set in Netlify → Environment variables
DEEPSEEK_API_KEY=your_deepseek_api_key_here
